# Sample only -- copy to .streamlit/secrets.toml for local use (git-ignored, never
# committed). On Streamlit Community Cloud these go in the app's own
# Settings -> Secrets panel instead of a file; paste this same TOML shape in there.
#
# Sets the first admin the app creates the moment none exists yet in the account
# store -- see app/bootstrap.py. Safe to leave in place after that: it becomes a
# no-op once an admin exists, and fires again on its own if a host with no
# persistent disk (e.g. Community Cloud) wipes the store on a restart.
#
# Password policy is the same as any account's: 12-256 characters (see
# app/accounts/passwords.py). Pick one nobody has typed anywhere else.

SOLIT2_ADMIN_EMAIL = "admin@example.test"
SOLIT2_ADMIN_PASSWORD = "replace with a fresh 12+ character password"

# Optional -- default to "Administrator" / "-" when left out.
# SOLIT2_ADMIN_NAME = "Ali Sajil"
# SOLIT2_ADMIN_ORGANISATION = "Mistelix"
